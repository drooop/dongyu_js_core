# Local K8s deployment configuration
# Copy to local.env and fill in values:
#   cp deploy/env/local.env.example deploy/env/local.env

# Kubernetes
# Local acceptance uses OrbStack only.
K8S_CONTEXT=orbstack
NAMESPACE=dongyu

# Matrix transport
# Management-bus traffic stays inside the local cluster.
MATRIX_HOMESERVER_URL=http://synapse.dongyu.svc.cluster.local:8008
SYNAPSE_SERVER_NAME=localhost
SYNAPSE_SECRET=dongyu-synapse-secret-2026
SERVER_USER=drop
SERVER_PASSWORD=${LOCAL_SYNAPSE_DROP_PASSWORD:?set LOCAL_SYNAPSE_DROP_PASSWORD}
MBR_USER=mbr
MBR_PASSWORD=${LOCAL_SYNAPSE_MBR_PASSWORD:?set LOCAL_SYNAPSE_MBR_PASSWORD}

# MQTT
MQTT_HOST=mosquitto.dongyu.svc.cluster.local
MQTT_PORT=1883

# UI Server
SEED_POSITIVE_MODELS_ON_BOOT=0
DY_AUTH=0
DY_DEV_FAKE_LOGIN=0
DY_OIDC_ISSUER=
DY_OIDC_CLIENT_ID=
DY_OIDC_CLIENT_SECRET=
DY_OIDC_REDIRECT_URI=
DY_OIDC_SCOPE=
DY_OIDC_PROXY_URL=
DY_OIDC_FETCH_TIMEOUT_MS=10000
DY_OIDC_STATE_SECRET=
DY_SESSION_SECRET=
DY_AUTH_SECRET=
