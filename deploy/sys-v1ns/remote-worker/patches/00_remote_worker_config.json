      "k": "r1_endpoint_dispatch",
      "t": "func.js",
      "v": {
        "code": "const records = Array.isArray(label && label.v) ? label.v : [];\nconst rootRecord = (key) => records.find((record) => record && record.id === 0 && record.p === 0 && record.r === 0 && record.c === 0 && record.k === key) || null;\nconst readString = (key) => { const record = rootRecord(key); return record && record.t === 'str' && typeof record.v === 'string' ? record.v : ''; };\nconst readInt = (key) => { const record = rootRecord(key); return record && record.t === 'int' && Number.isInteger(record.v) ? record.v : null; };\nconst routeLabel = V1N.readLabel(0, 0, 0, 'r1_endpoint_route_table');\nconst routes = routeLabel && Array.isArray(routeLabel.v) ? routeLabel.v : [];\nconst endpointWorkerId = readString('endpoint_worker_id');\nconst endpointModelId = readInt('endpoint_model_id');\nconst endpointPin = readString('endpoint_pin');\nconst messageRole = readString('message_role');\nconst route = routes.find((candidate) => candidate && candidate.model_id === endpointModelId && candidate.pin === endpointPin);\nif (messageRole !== 'request' || endpointWorkerId !== 'R1' || !route || typeof route.output_pin !== 'string') {\n  V1N.addLabel('r1_dispatch_error', 'json', { code: 'endpoint_route_not_declared', endpoint_worker_id: endpointWorkerId, endpoint_model_id: endpointModelId, endpoint_pin: endpointPin, ts: Date.now() });\n  return;\n}\nV1N.removeLabel('r1_dispatch_error');\nV1N.addLabel(route.output_pin, 'pin.out', records);",
